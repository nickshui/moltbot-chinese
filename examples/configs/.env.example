# 环境变量配置示例
# 将此文件复制为 .env 并填入您的实际值

# ============================================
# API 密钥配置
# ============================================

# Anthropic Claude API 密钥
# 获取地址：https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# OpenAI API 密钥
# 获取地址：https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# ============================================
# 消息平台配置
# ============================================

# Telegram Bot Token
# 从 @BotFather 获取
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz

# Discord Bot Token
# 从 Discord 开发者门户获取
DISCORD_BOT_TOKEN=MTk4NjIyNDgzNA.GlKPqr.abcdefghijklmnopqrstuvwxyz1234567890

# Discord Application ID
DISCORD_APP_ID=1234567890123456789

# Slack Bot Token
# 从 Slack App 管理页面获取
SLACK_BOT_TOKEN=xoxb-your-bot-token-here
SLACK_APP_TOKEN=xapp-your-app-token-here

# Microsoft Teams
TEAMS_APP_ID=your-teams-app-id
TEAMS_APP_PASSWORD=your-teams-app-password

# ============================================
# 语音服务配置（可选）
# ============================================

# ElevenLabs API 密钥（用于语音合成）
# 获取地址：https://elevenlabs.io/
ELEVENLABS_API_KEY=your-elevenlabs-api-key

# ============================================
# 网关配置
# ============================================

# 网关端口
MOLTBOT_GATEWAY_PORT=18789

# 日志级别：debug, info, warn, error
MOLTBOT_LOG_LEVEL=info

# 数据目录
MOLTBOT_DATA_DIR=~/.moltbot

# ============================================
# 模型配置
# ============================================

# 默认使用的模型
MOLTBOT_DEFAULT_MODEL=claude-opus-4.5

# 思考级别：low, medium, high
MOLTBOT_THINKING_LEVEL=high

# ============================================
# 安全配置
# ============================================

# 是否启用配对模式（推荐：true）
MOLTBOT_ENABLE_PAIRING=true

# 配对超时时间（秒）
MOLTBOT_PAIRING_TIMEOUT=300

# ============================================
# 其他配置
# ============================================

# 时区
TZ=Asia/Shanghai

# Node 环境
NODE_ENV=production

# ============================================
# 使用说明
# ============================================

# 1. 将此文件复制为 .env：
#    cp .env.example .env

# 2. 填入您的实际密钥和配置值

# 3. 确保 .env 文件不会被提交到版本控制：
#    echo ".env" >> .gitignore

# 4. 在启动 Moltbot 时，环境变量会自动加载

# ⚠️ 安全提示：
# - 永远不要在公共仓库中提交包含真实密钥的 .env 文件
# - 定期轮换 API 密钥
# - 限制 API 使用配额和权限
# - 使用最小权限原则配置机器人权限
