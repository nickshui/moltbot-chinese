# Moltbot 中文版 .gitignore

# ============================================
# 敏感信息 - 永远不要提交！
# ============================================

# 环境变量文件
.env
.env.local
.env.*.local
*.env

# 配置文件（如果包含密钥）
config.json
config.local.json

# API 密钥和令牌
*.key
*.token
secrets/
credentials/

# ============================================
# Moltbot 数据和缓存
# ============================================

# 数据目录
.moltbot/
data/
sessions/
cache/

# 日志文件
*.log
logs/
*.log.*

# WhatsApp 会话
whatsapp-session/
.wwebjs_auth/
.wwebjs_cache/

# 临时文件
*.tmp
*.temp
tmp/
temp/

# ============================================
# Node.js
# ============================================

# 依赖
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 构建输出
dist/
build/
out/
.next/

# 测试覆盖率
coverage/
*.lcov
.nyc_output

# Package locks（根据团队偏好选择保留或忽略）
# package-lock.json
# yarn.lock
# pnpm-lock.yaml

# ============================================
# 操作系统文件
# ============================================

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.directory
.Trash-*

# ============================================
# 编辑器和 IDE
# ============================================

# Visual Studio Code
.vscode/
!.vscode/settings.json.example
!.vscode/extensions.json.example
*.code-workspace

# JetBrains IDEs (WebStorm, IntelliJ, etc.)
.idea/
*.iml
*.ipr
*.iws
out/

# Sublime Text
*.sublime-project
*.sublime-workspace

# Vim
[._]*.s[a-v][a-z]
[._]*.sw[a-p]
[._]s[a-rt-v][a-z]
[._]ss[a-gi-z]
[._]sw[a-p]
Session.vim
Sessionx.vim
.netrwhist

# Emacs
*~
\#*\#
.\#*

# ============================================
# 版本控制
# ============================================

# Git
.git/
.gitattributes.local

# Mercurial
.hg/
.hgignore
.hgsigs
.hgsub
.hgsubstate
.hgtags

# ============================================
# 其他
# ============================================

# 备份文件
*.bak
*.backup
*.old
*.orig

# 压缩文件
*.zip
*.tar
*.gz
*.tgz
*.rar
*.7z

# 证书文件
*.pem
*.cer
*.crt
*.p12
*.pfx

# 数据库文件
*.db
*.sqlite
*.sqlite3

# ============================================
# 项目特定
# ============================================

# 测试输出
test-results/
playwright-report/
playwright/.cache/

# 文档构建
docs/_build/
site/

# 草稿和笔记
NOTES.md
TODO.md
DRAFT.md

# 本地开发配置
.local/
local/

# ============================================
# 允许的文件（示例）
# ============================================

# 配置示例文件应该被提交
!examples/configs/*.json
!examples/configs/.env.example
!examples/configs/README.md
